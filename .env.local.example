# Shared password to access the catalog
NEXT_PUBLIC_SITE_PASSWORD=your-password

# Separate password for the invoice page
NEXT_PUBLIC_INVOICE_PASSWORD=your-invoice-password

# Google Sheets published CSV export URL
NEXT_PUBLIC_EXCEL_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv

# Dashboard password
NEXT_PUBLIC_DASHBOARD_PASSWORD=dashboard123
